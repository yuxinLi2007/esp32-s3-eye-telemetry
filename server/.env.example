# 模板文件：复制成同目录下的 .env 再填。
#   copy .env.example .env
# .env 已被 .gitignore 排除，不会进仓库。
# 启动时用 uvicorn --env-file .env 读取（start_server.bat 已带该参数）。

# 入库鉴权。服务端校验请求头 X-Ingest-Token。
# 不设置 = 任何能访问该端口的人都能以任意 MAC、任意时间戳灌数据，
# "数据来源可追溯"就无从谈起。本地开发可以不设，公网部署必须先设。
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# 采集开关 / 指令下发鉴权。服务端校验请求头 X-Control-Token。
# 此令牌同时保护第 2 周的远程指令面板与第 4 周的自然语言“请求采集”路径。
# 注意设备轮询用的 GET /api/v1/control/state 不校验此令牌——那是刻意的，
# 板子把"取不到"当成"照常采集"，配错令牌会让它静默停采，反而更糟。
CONTROL_TOKEN=

# 数据库路径。不设则默认 server/data/telemetry.db
# TELEMETRY_DB=

# ---- 第 4 周：运行时语言模型（自然语言入口的可选增强）----
# 三个都配置了，/api/v1/assistant/chat 才会调用语言模型做意图解析；
# 解析失败 / 超时 / 缺任一变量都会自动降级到确定性关键字规则，功能不失效。
# 与开发助手分开配置：运行时密钥只留在服务端环境变量，不入库、不进前端。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# 允许自然语言对其下发的设备白名单（逗号分隔的 MAC 列表）。
# 不设 = 自动使用本系统真正见过（batches 表里去重）的设备。
# DEVICE_MAC_WHITELIST=

# ---- 第 5 周：语音链路（ASR / TTS）----
# 语音服务密钥只存服务端环境变量，前端/设备请求里从不携带。
# 未配置或调用失败时，语音接口返回明确错误码（界面如实提示"识别失败/合成失败"），
# 不做任何假装成功。
# VOICE_ASR_URL=            # ASR 服务（POST multipart file -> {"text": "..."}）
# VOICE_TTS_URL=            # TTS 服务（POST json {"text","model"} -> audio 字节流）
# VOICE_API_KEY=
# VOICE_MODEL=
# VOICE_DEVICE_AUDIO=0      # 设备音频（板载 I2S 麦克风）流是否接通：1=设备音频，0/空=电脑音频

# ---- 第 7 周：按需环境快照（最少保留）----
# 图像本体存磁盘（默认 server/data/snapshots，被 .gitignore 排除）；
# 元数据表 snapshots 保留"最少保留"内的记录，超出数量/时间上限即清理文件与记录。
# SNAPSHOT_DIR=
# SNAPSHOT_KEEP_MAX=20      # 最多保留最近多少张
# SNAPSHOT_KEEP_MS=86400000 # 最多保留多少毫秒（默认 24 小时）
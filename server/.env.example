# 模板文件：复制成同目录下的 .env 再填。
#   copy .env.example .env
# .env 已被 .gitignore 排除，不会进仓库。
# 启动时用 uvicorn --env-file .env 读取（start_server.bat 已带该参数）。

# 入库鉴权。服务端校验请求头 X-Ingest-Token。
# 不设置 = 任何能访问该端口的人都能以任意 MAC、任意时间戳灌数据，
# "数据来源可追溯"就无从谈起。本地开发可以不设，公网部署必须先设。
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# 采集开关鉴权。服务端校验请求头 X-Control-Token。
# 这个比 INGEST_TOKEN 更该设：开关一旦被外人动过，板子照样在跑、只是不再上传，
# 界面上和"设备失联"一模一样，受害者根本察觉不到。
# 注意设备轮询用的 GET /api/v1/control/state 不校验此令牌——那是刻意的，
# 板子把"取不到"当成"照常采集"，配错令牌会让它静默停采，反而更糟。
CONTROL_TOKEN=

# 数据库路径。不设则默认 server/data/telemetry.db
# TELEMETRY_DB=

# ---------- 第4周：自然语言助手 ----------
# 全部可选。不设 OPENAI_API_KEY 时 assistant 自动走离线规则引擎，功能不失效。
# 设了 key 就用模型做意图翻译；模型报错 / 超时 / 返回垃圾都会降级到规则，并在
# /api/v1/assistant/ask 的 trace.llm_error 里留痕。

# 模型凭据。留空 = 不用模型。
OPENAI_API_KEY=

# 模型名与兼容端点。BASE_URL 可指向自建网关 / 本地推理服务（需 OpenAI 兼容）。
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 单次模型调用超时（秒）。
ASSISTANT_LLM_TIMEOUT_S=8

# 设 0 = 即使有 key 也彻底关闭模型通道，只走规则。
ASSISTANT_LLM_ENABLED=1

# 助手可操作的设备白名单，逗号分隔，如 94:A9:90:1C:6F:D4,AA:BB:CC:DD:EE:FF
# 设了 = 只认这一份（公网部署口径）；不设 = 用 batches 里"服务端见过的设备"（本地零配置）。
# 无论哪种，"控制别人的设备"都命中 forbidden_device。
DEVICE_ALLOWLIST=

# 模板文件：复制成同目录下的 .env 再填。
#   copy .env.example .env
# .env 已被 .gitignore 排除，不会进仓库。
# 启动时用 uvicorn --env-file .env 读取（start_server.bat 已带该参数）。

# 入库鉴权。服务端校验请求头 X-Ingest-Token。
# 不设置 = 任何能访问该端口的人都能以任意 MAC、任意时间戳灌数据，
# "数据来源可追溯"就无从谈起。本地开发可以不设，公网部署必须先设。
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# 采集开关鉴权。服务端校验请求头 X-Control-Token。
# 这个比 INGEST_TOKEN 更该设：开关一旦被外人动过，板子照样在跑、只是不再上传，
# 界面上和"设备失联"一模一样，受害者根本察觉不到。
# 注意设备轮询用的 GET /api/v1/control/state 不校验此令牌——那是刻意的，
# 板子把"取不到"当成"照常采集"，配错令牌会让它静默停采，反而更糟。
CONTROL_TOKEN=

# 数据库路径。不设则默认 server/data/telemetry.db
# TELEMETRY_DB=
